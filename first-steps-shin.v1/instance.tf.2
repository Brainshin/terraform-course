# 1. AWS 공급자 설정 (주석을 모두 제거하고 서울 리전을 명시했습니다)
provider "aws" {
  region = "ap-northeast-2"
}

# 2. Apple Silicon 환경 무료 가상 서버 정의
resource "aws_instance" "example" {
  ami           = "ami-04169527f30df0f63" # 서울 리전 공식 최신 Ubuntu 24.04 LTS ARM64용 ID
  instance_type = "t4g.micro"             # Graviton2 무료 프리 티어 타입

  tags = {
    Name = "aws-ec2-server" # 16시 50분 자동 종료 스크립트 연동용 태그
  }
}
