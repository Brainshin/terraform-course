# ==========================================================================
# [출력 대상] 생성된 웹 서버(EC2 인스턴스)의 퍼블릭 IP 주소
# [참조 위치] aws_instance 리소스 유형의 "web"이라는 이름을 가진 자원
# [활용 목적] 배포 완료 후, 웹 브라우저나 SSH 터미널을 통해 서버에 직접 접속하기 위한 외부 IP 확인
# ==========================================================================
output "public_ip" { 
  # value = aws_instance.web.public_ip
  value = aws_instance.web.public_ip
}

# ==========================================================================
# [출력 대상] 가상 네트워크(VPC) 내부에 생성된 퍼블릭 서브넷(Public Subnet) ID 목록
# [참조 위치] 외부 vpc 모듈(module.vpc) 내부에 정의된 public_subnets 출력값
# [활용 목적] 로드밸런서(ALB)나 베스천 호스트 등 외부에 노출되어야 하는 다른 자원들을 배치할 위치 지정
# ==========================================================================
output "public_subnets" { 
  value = module.vpc.public_subnets
}

# ==========================================================================
# [출력 대상] 생성된 가상 네트워크(VPC)의 고유 식별자(ID)
# [참조 위치] 외부 vpc 모듈(module.vpc) 내부에 정의된 vpc_id 출력값
# [활용 목적] 향후 보안 그룹(Security Group) 설정이나 서브넷 추가 시, 이 인프라가 속할 네트워크 인스턴스를 지정
# ==========================================================================
#output "vpc_id" { 
#  value = module.vpc.vpc_id
#}
